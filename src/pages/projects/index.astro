---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import ReportShelf from '../../components/ReportShelf.astro';
import { getProjects } from '../../lib/content';
import { PROJECT_GITHUB, PROJECT_GROUPS, SOCIAL } from '../../consts';

const all = await getProjects();
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/['’]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const githubIcon = SOCIAL.find((s) => s.label === 'GitHub')?.icon;

// Per section: websites first, then reports on a shelf, then the GitHub organisations.
const groups = PROJECT_GROUPS.map((title) => {
  const items = all.filter((p) => p.data.group === title);
  return {
    title,
    id: slug(title),
    websites: items.filter((p) => p.data.kind === 'website'),
    reports: items.filter((p) => p.data.kind === 'report'),
    github: PROJECT_GITHUB[title] ?? [],
  };
}).filter((g) => g.websites.length || g.reports.length);
---

<Base title="Projects" description="Websites, tools and reports I've built and contributed to.">
  <h1>Projects</h1>
  <nav class="toc" aria-label="Sections">
    {groups.map((g, i) => (
      <>
        {i > 0 && (
          <span class="toc-sep" aria-hidden="true">
            ·
          </span>
        )}
        <a href={`#${g.id}`}>{g.title.replace("'", '’')}</a>
      </>
    ))}
  </nav>

  {groups.map((g) => (
    <section id={g.id}>
      <h2>{g.title.replace("'", '’')}</h2>
      {g.websites.length > 0 && <ProjectGrid projects={g.websites} />}
      {g.reports.length > 0 && (
        <div class="reports">
          <h3>Reports</h3>
          <ReportShelf reports={g.reports} />
        </div>
      )}
      {g.github.length > 0 && (
        <p class="github">
          <span class="github-label">More on GitHub</span>
          {g.github.map((org) => (
            <a
              class="org"
              href={`https://github.com/${org}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d={githubIcon} />
              </svg>
              {org}
            </a>
          ))}
        </p>
      )}
    </section>
  ))}
</Base>

<style>
  h1 {
    font-size: var(--step-3);
    margin: 0 0 var(--space-3);
  }

  /* Table of contents: one quiet line of section links. */
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--color-muted);
  }
  .toc a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-link-line);
  }
  .toc-sep {
    color: var(--color-faint);
  }

  section {
    scroll-margin-top: var(--space-4);
  }
  section + section {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
  }
  h2 {
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-fg);
  }
  h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 var(--space-4);
  }
  .reports {
    margin-top: var(--space-6);
  }

  /* GitHub organisations: quiet chips at the end of a section. */
  .github {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    font-size: 0.8125rem;
  }
  .github-label {
    color: var(--color-muted);
    margin-right: var(--space-1);
  }
  .org {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3em 0.7em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-fg);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .org:hover {
    border-color: var(--color-fg);
  }
</style>
