---
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getArt } from '../../lib/content';

const works = await getArt();
---

<Base title="Visuals" description="Video, VJing, installations and film.">
  <h1 class="page-title">Visuals</h1>
  <ul class="works">
    {works.map((w) => (
      <li>
        <a href={`/art/${w.id}/`}>
          {w.data.cover && (
            <Image
              src={w.data.cover}
              alt=""
              widths={[400, 800, 1200]}
              sizes="(min-width: 40rem) 33vw, 100vw"
            />
          )}
          <span class="title">{w.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  /* Masonry: CSS columns, so each cover keeps its own aspect ratio (no crop).
     Items flow top to bottom, column by column, in `order`. */
  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 16rem;
    column-gap: var(--space-4);
  }
  li {
    break-inside: avoid;
    margin-bottom: var(--space-5);
  }
  a {
    text-decoration: none;
    display: block;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.15);
  }
  a:hover img {
    filter: none;
  }
  /* Catalogue / wall-label style: artwork titles in italic serif, set tight under the image. */
  .title {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 150ms;
  }
  a:hover .title,
  a:focus-visible .title {
    text-decoration-color: currentColor;
  }
</style>
