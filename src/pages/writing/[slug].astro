---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { sourceUrl, fmtDate, getWriting, hasSource, isoDate, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const source = hasSource(post);
---

<Article title={post.data.title} description={post.data.description} draft={post.data.draft} source={sourceUrl(post)}>
  <p slot="meta" class="meta">
    <time datetime={isoDate(post.data.date)}>{fmtDate(post.data.date)}</time>
    {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
    {source && <span> · rendered from {source}</span>}
  </p>
  <Content />
</Article>

<style>
  .meta { margin: var(--space-3) 0 0; font-size: var(--step--1); color: var(--color-muted); }
</style>
