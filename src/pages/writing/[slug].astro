---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Label from '../../components/Label.astro';
import { sourceUrl, fmtDate, getWriting, isoDate, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
const time = (date: Date) => `<time datetime="${isoDate(date)}">${fmtDate(date)}</time>`;
---

<Article
  title={d.title}
  description={d.description}
  kicker={d.archive ? 'Writing · Archive' : 'Writing'}
  draft={d.draft}
  source={sourceUrl(post)}
>
  <Label
    slot="meta"
    inline
    items={[
      ['Published', time(d.date)],
      ['Updated', d.updated && time(d.updated)],
      ['Tags', d.tags, { muted: true }],
    ]}
  />
  <Content />
</Article>
