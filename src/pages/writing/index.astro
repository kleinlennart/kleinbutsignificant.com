---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getWriting } from '../../lib/content';

const posts = await getWriting();
// Older posts (`archive: true`) get their own section below the current ones.
const current = posts.filter((p) => !p.data.archive);
const archived = posts.filter((p) => p.data.archive);
---

<Base title="Writing" description="Essays, notes and computational posts.">
  <h1 class="page-title">Writing</h1>
  {current.length > 0 && <PostList posts={current} />}
  {archived.length > 0 && (
    <section class="archive" aria-labelledby="archive">
      <h2 id="archive" class="section-title">
        Archive
      </h2>
      <PostList posts={archived} />
    </section>
  )}
</Base>

<style>
  .archive {
    margin-top: var(--space-6);
    max-width: 44rem; /* same width as the post list */
  }
  /* The first section on the page when there are no current posts yet. */
  .page-title + .archive {
    margin-top: 0;
  }
  /* The post list brings its own top spacing. */
  .section-title {
    margin-bottom: var(--space-2);
  }
</style>
