---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects, getWriting } from '../lib/content';
import '../styles/prose.css';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('content/pages/home.md is missing');
const { Content } = await render(home);

const featured = (await getProjects()).filter((p) => p.data.featured);
const recent = (await getWriting()).slice(0, 6);
---

<Base description={home.data.description}>
  <section class="intro">
    {home.data.portrait && (
      <div class="portrait">
        <Image
          src={home.data.portrait}
          alt="Portrait of Lennart Klein"
          width={480}
          height={480}
          fit="cover"
          layout="fixed"
          loading="eager"
        />
      </div>
    )}
    <h1>{home.data.title}</h1>
    <div class="intro-text"><Content /></div>
  </section>

  <section>
    <h2 class="section-title"><a href="/projects/">Selected work</a></h2>
    <ProjectGrid projects={featured} />
  </section>

  <section>
    <h2 class="section-title"><a href="/writing/">Writing</a></h2>
    <PostList posts={recent} />
  </section>
</Base>

<style>
  .intro { margin-bottom: var(--space-6); }
  .portrait {
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: var(--space-4);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 6px 18px rgb(0 0 0 / 0.12);
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 40rem) {
    .portrait { width: 12.5rem; height: 12.5rem; } /* 200px */
  }
  .intro h1 { font-size: var(--step-4); letter-spacing: -0.03em; margin: 0 0 var(--space-4); }
  .intro-text {
    max-width: 38rem;
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.5;
    letter-spacing: -0.003em;
  }
  .intro-text :global(p) { margin: 0; }
  .intro-text :global(p + p) { margin-top: 0.85em; }
  .intro-text :global(strong) { font-weight: 600; }
  section + section { margin-top: var(--space-6); }
  .section-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-3);
  }
  .section-title a { text-decoration: none; }
</style>
