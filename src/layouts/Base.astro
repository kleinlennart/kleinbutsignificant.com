---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { SITE, NAV, STACK } from '../consts';

interface Props {
  title?: string;
  /** Full <title> override, used as-is. */
  fullTitle?: string;
  description?: string;
  /** Absolute URL of a share image (Open Graph). */
  image?: string;
}

const { title, fullTitle, description = SITE.description, image } = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} · ${SITE.title}` : SITE.title);
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon16.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    {image && <meta property="og:image" content={image} />}
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header wrap">
      <a class="site-name" href="/">{SITE.title}</a>
      <nav aria-label="Main">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <span class="grp">Built with {STACK.map((t, i) => (
        <>{i > 0 && (i === STACK.length - 1 ? ' & ' : ', ')}<a href={t.href} rel="noopener">{t.label}</a></>
      ))}</span><span class="sep"> · </span><span class="grp"><a href={SITE.repo} rel="noopener">Source</a> · <a href="/rss.xml">RSS</a> · © {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4) clamp(var(--space-3), 3vh, var(--space-5));
  }
  .site-name {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.025em;
    text-decoration: none;
  }
  .site-name:hover { color: inherit; }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    color: var(--color-muted);
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--color-fg); }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-accent); }

  /* One quiet line; body is a flex column, so it sits at the bottom of short pages. */
  .site-footer {
    text-align: center;
    margin-top: var(--space-3);
    padding-block: var(--space-2) var(--space-3);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-faint);
  }
  /* Phones: two stacked lines, no separator. Desktop: one line. */
  .site-footer .grp { display: block; }
  .site-footer .sep { display: none; }
  @media (min-width: 40rem) {
    .site-footer .grp, .site-footer .sep { display: inline; }
  }
  .site-footer a { text-decoration-color: transparent; }
  .site-footer a:hover { text-decoration-color: currentColor; }
</style>
