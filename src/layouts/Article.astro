---
import Base from './Base.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  draft?: boolean;
  /** This page's source file on GitHub; surfaces only via the footer "Source" link. */
  source?: string;
}
const { title, description, kicker, draft, source } = Astro.props;
---

<Base title={title} description={description} source={source}>
  <article>
    <header class="article-header">
      {kicker && <p class="kicker"><Fragment set:html={kicker} /></p>}
      <h1>{title}{draft && <span class="draft">Draft</span>}</h1>
      {description && <p class="lede">{description}</p>}
      <slot name="meta" />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .article-header { max-width: calc(var(--measure) + 6rem); margin-bottom: var(--space-5); }
  h1 { font-size: var(--step-4); margin: 0; letter-spacing: -0.025em; }
  .kicker {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .lede { font-size: var(--step-1); color: var(--color-muted); margin: var(--space-3) 0 0; max-width: var(--measure); }
  .draft {
    font-size: var(--step--1);
    vertical-align: middle;
    margin-left: var(--space-3);
    padding: 0.1em 0.5em;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
