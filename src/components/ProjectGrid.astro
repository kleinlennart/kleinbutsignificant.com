---
import type { CollectionEntry } from 'astro:content';

interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const clean = (v?: string) => (v && v !== 'TODO' ? v : undefined);
---

<ul class="grid">
  {projects.map((p) => (
    <li>
      <a href={`/projects/${p.id}/`}>
        <span class="meta">{[clean(p.data.org), clean(p.data.years)].filter(Boolean).join(' · ')}</span>
        <span class="title">{p.data.title}</span>
        {!p.data.summary.startsWith('TODO') && <span class="summary">{p.data.summary}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    border-top: 1px solid var(--color-fg);
  }
  li { border-bottom: 1px solid var(--color-rule); }
  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3) var(--space-3) var(--space-4) 0;
    text-decoration: none;
  }
  a:hover .title { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .meta { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted); }
  .title { font-size: var(--step-1); font-weight: 650; line-height: 1.2; }
  .summary { color: var(--color-muted); font-size: var(--step--1); }
</style>
