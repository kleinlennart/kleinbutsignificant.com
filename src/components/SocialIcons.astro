---
import { SOCIAL } from '../consts';
// The email link is spam-protected by the script in Base.astro (data-email).

// Envelope (filled, matches the other icons), 24×24.
const MAIL_ICON =
  'M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm.3 2.2-.6 1.6L12 14.6l10.3-6.8-.6-1.6L12 12.6z';
---

<ul class="socials">
  {SOCIAL.map((s) => (
    <li>
      <a
        href={s.href}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label={s.label}
        title={s.label}
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
          <path d={s.icon} />
        </svg>
      </a>
    </li>
  ))}
  <li>
    <a href="#email" data-email aria-label="Email" title="Email">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        aria-hidden="true"
        fill="currentColor"
        fill-rule="evenodd"
      >
        <path d={MAIL_ICON} />
      </svg>
    </a>
  </li>
</ul>

<style>
  .socials {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: block;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--color-fg);
  }
  svg {
    display: block;
  }
</style>
