---
import { SOCIAL } from '../consts';
---

<ul class="socials">
  {SOCIAL.map((s) => (
    <li>
      <a href={s.href} rel="me noopener" aria-label={s.label} title={s.label}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
          <path d={s.icon} />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .socials {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: block;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }
  a:hover { color: var(--color-fg); }
  svg { display: block; }
</style>
