---
// Reports as title pages standing on a shelf, newest first. Covers are vector SVGs of the
// PDF's first page (crisp at any zoom); without a cover, a typographic stand-in is drawn.
import type { CollectionEntry } from 'astro:content';
import { capsSafe } from '../lib/text';

interface Props {
  reports: CollectionEntry<'projects'>[];
}
const reports = [...Astro.props.reports].sort(
  (a, b) => (b.data.published?.valueOf() ?? 0) - (a.data.published?.valueOf() ?? 0),
);
const real = (v?: string) => (v && !v.startsWith('TODO') ? v : undefined);
const monthYear = (d?: Date) =>
  d?.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<ul class="books">
  {reports.map((r) => {
    const href = r.data.url;
    const Tag = href ? 'a' : 'div';
    const cover = r.data.cover;
    return (
      <li class:list={[{ draft: r.data.draft }]}>
        <Tag class="book" {...(href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {})}>
          <div class="cover">
            {cover ? (
              <img
                src={cover.src}
                width={cover.width}
                height={cover.height}
                alt={`Title page: ${r.data.title}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="standin">
                <span class="standin-org" set:html={capsSafe(r.data.group)} />
                <span class="standin-title">{r.data.title}</span>
              </div>
            )}
          </div>
          <span class="ledge" aria-hidden="true" />
          <span class="title">
            {r.data.title}
            {r.data.draft && <span class="draft-tag">Draft</span>}
          </span>
        </Tag>
        {real(r.data.summary) && <span class="subtitle">{r.data.summary}</span>}
        {r.data.published && (
          <time class="date" datetime={r.data.published.toISOString().slice(0, 10)}>
            {monthYear(r.data.published)}
          </time>
        )}
      </li>
    );
  })}
</ul>

<style>
  .books {
    --cover-w: clamp(10rem, 28vw, 13.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--cover-w), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--cover-w);
  }
  .book {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  /* The title page stands on a ledge: portrait page, spine shading, soft drop shadow. */
  .cover {
    aspect-ratio: 612 / 792;
    background: #fff;
    border-radius: 2px 4px 4px 2px;
    box-shadow:
      inset 3px 0 4px -2px rgb(0 0 0 / 0.2),
      0 1px 2px rgb(0 0 0 / 0.12),
      0 12px 24px -8px rgb(0 0 0 / 0.3);
    overflow: hidden;
    transform-origin: bottom center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  a.book:hover .cover,
  a.book:focus-visible .cover {
    transform: translateY(-4px) rotate(-1deg);
    box-shadow:
      inset 3px 0 4px -2px rgb(0 0 0 / 0.2),
      0 2px 4px rgb(0 0 0 / 0.12),
      0 20px 32px -10px rgb(0 0 0 / 0.32);
  }
  .ledge {
    display: block;
    height: 3px;
    margin: 0 -0.75rem var(--space-3);
    background: var(--color-rule);
    border-radius: 2px;
  }
  .title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  a.book:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .subtitle {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .date {
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .standin {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 12% 11%;
    gap: 0.5rem;
    background: linear-gradient(180deg, #fafafa, #f0f0ee);
    color: #111;
  }
  .standin-org {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
  }
  .standin-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.15;
    margin-top: auto;
  }

  .draft {
    opacity: 0.6;
  }
  .draft-tag {
    margin-left: var(--space-2);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    padding: 0.05em 0.35em;
    vertical-align: middle;
  }
</style>
