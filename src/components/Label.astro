---
// Museum "wall label": a compact definition list of facts about a work or project.
// `inline`: one row; the last item takes the remaining width and wraps within itself (e.g. tags).
// A third element { muted: true } sets that value in regular weight and the muted colour.
interface Props {
  items: Array<
    | [string, string | string[] | undefined | null]
    | [string, string | string[] | undefined | null, { muted?: boolean }]
  >;
  inline?: boolean;
}
const { inline = false } = Astro.props;
const rows = Astro.props.items
  .map(([k, v, opts]) => [k, Array.isArray(v) ? v.join(', ') : v, opts?.muted ?? false] as const)
  .filter(([, v]) => v && v !== 'TODO');
---

{rows.length > 0 && (
  <dl class:list={['label', { inline }]}>
    {rows.map(([k, v, muted]) => (
      <div>
        <dt>{k}</dt>
        <dd class:list={{ muted }} set:html={v} />
      </div>
    ))}
  </dl>
)}

<style>
  .label {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-3) var(--space-4);
    margin: var(--space-4) 0 var(--space-5);
    padding-block: var(--space-3);
    border-block: 1px solid var(--color-fg);
    font-size: var(--step--1);
  }
  .inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .inline > div:last-child {
    flex: 1 1 14rem;
  }
  dt {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  dd :global(a) {
    font-weight: 600;
  }
  dd.muted {
    font-weight: 400;
    color: var(--color-muted);
  }
</style>
