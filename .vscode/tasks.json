// Run with Terminal → Run Task… (or ⇧⌘P "Tasks: Run Task").
// ⇧⌘B runs the default build task; "Tasks: Run Test Task" runs verify.
// typecheck and lint report problems into the Problems panel.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Astro dev server on http://localhost:4321 (drafts visible)",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev:public",
      "detail": "Astro dev server on http://localhost:4321 (drafts hidden, like production; stop dev first)",
      "type": "shell",
      "command": "pnpm dev:public",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev:status",
      "detail": "Is a dev server running (yours or an agent's)? URL, pid, mode and last log lines",
      "type": "shell",
      "command": "pnpm --silent astro dev status; grep -h -o 'drafts [a-z]* ([a-z: ]*)' .astro/dev.log | tail -1; tail -5 .astro/dev.log",
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "dev:stop",
      "detail": "Kill every Astro dev/preview server of this project (also orphans left by closed task terminals)",
      "type": "shell",
      "command": "pkill -f '${workspaceFolder}/node_modules/.*astro\\.mjs (dev|preview)' && echo 'Stopped Astro dev/preview servers.' || echo 'No Astro dev/preview servers running.'",
      "presentation": { "reveal": "silent", "close": true },
      "problemMatcher": []
    },
    {
      "label": "build",
      "detail": "Static build into dist/ (drafts excluded)",
      "type": "shell",
      "command": "pnpm build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "preview",
      "detail": "Build, then serve dist/ locally",
      "type": "shell",
      "command": "pnpm preview",
      "dependsOn": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "detail": "astro check: TypeScript and content schemas",
      "type": "shell",
      "command": "pnpm check",
      "presentation": { "clear": true },
      "problemMatcher": {
        "owner": "astro-check",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+) - (error|warning) (\\w+\\(\\d+\\)): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    },
    {
      "label": "lint",
      "detail": "oxlint",
      "type": "shell",
      "command": "pnpm lint --format=unix",
      "presentation": { "clear": true },
      "problemMatcher": {
        "owner": "oxlint",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.*) \\[(Error|Warning)/(.+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "severity": 5,
          "code": 6
        }
      }
    },
    {
      "label": "format",
      "detail": "Prettier (web), Air (.R), Ruff (.py): rewrite files in place; content/ and Markdown are skipped",
      "type": "shell",
      "command": "pnpm format && air format . && uv run ruff format .",
      "problemMatcher": []
    },
    {
      "label": "format:check",
      "detail": "Prettier, Air, Ruff: list files that are not formatted, change nothing",
      "type": "shell",
      "command": "pnpm format:check && air format --check . && uv run ruff format --check .",
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "verify",
      "detail": "typecheck + lint + format:check",
      "dependsOn": ["typecheck", "lint", "format:check"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "new post",
      "detail": "Create content/writing/<slug>/ from templates/ (draft, dated today) and open it",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "new",
        "--type",
        "${input:postType}",
        { "value": "${input:postTitle}", "quoting": "weak" }
      ],
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "render post",
      "detail": "Quarto-render the open .qmd/.Rmd (then commit the .md, _files/ and _freeze/)",
      "type": "shell",
      "command": "pnpm",
      "args": ["render", { "value": "${file}", "quoting": "weak" }],
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "watch post",
      "detail": "Re-render the open .qmd/.Rmd on every save (Quarto preview without a server); pnpm dev shows it live",
      "type": "shell",
      "command": "pnpm",
      "args": ["watch", { "value": "${file}", "quoting": "weak" }],
      "isBackground": true,
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "postTitle",
      "type": "promptString",
      "description": "Post title (the URL slug is made from it)"
    },
    {
      "id": "postType",
      "type": "pickString",
      "description": "Post type",
      "options": [
        { "label": "Plain Markdown (.md)", "value": "md" },
        { "label": "Quarto + R (.qmd)", "value": "r" },
        { "label": "Quarto + Python (.qmd)", "value": "python" },
        { "label": "MDX: Markdown + components (.mdx)", "value": "mdx" }
      ],
      "default": "md"
    }
  ]
}
